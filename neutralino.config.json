{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.motivo.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.showSaveDialog",
    "os.showOpenDialog",
    "os.showFolderDialog",
    "os.getPath",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.writeBinaryFile",
    "filesystem.appendBinaryFile",
    "storage.getData",
    "storage.setData",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "Motivo \u2014 Procedural Game Music",
      "width": 1440,
      "height": 900,
      "minWidth": 1180,
      "minHeight": 720,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "motivo",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
